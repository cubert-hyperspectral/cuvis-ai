# gRPC Server Configuration
GRPC_PORT=50051
GRPC_MAX_WORKERS=10

# TLS/SSL Configuration (optional)
# Set GRPC_USE_TLS=true to enable TLS
GRPC_USE_TLS=false
GRPC_TLS_CERT_PATH=/path/to/cert.pem
GRPC_TLS_KEY_PATH=/path/to/key.pem

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Data Configuration
# Default data directory for data files
DATA_DIR=./data

# HuggingFace API Configuration
# HuggingFace API Token (optional, for private models/spaces)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Pipeline Configuration
# Root directory for all configs (pipeline configs are in CUVIS_CONFIGS_DIR/pipeline)
CUVIS_CONFIGS_DIR=./configs

# Child-runtime spawn deadlines (seconds)
# How long the orchestrator waits for a freshly spawned child runtime to (a) write
# its endpoint file and (b) report SERVING. Built-in default is 30s each. Raise them
# on slow machines / Windows, where the first cold CUDA-torch import in a freshly
# composed venv can exceed 30s and trip a spurious SpawnError.
CUVIS_RUNTIME_ENDPOINT_TIMEOUT_SECONDS=120
CUVIS_RUNTIME_HEALTH_TIMEOUT_SECONDS=120
